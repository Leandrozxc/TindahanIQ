# TindahanIQ Environment Configuration Template
# Copy this file to `.env` and customize values for your local environment.
# NEVER commit `.env` or real API keys to version control.

# Application runtime settings
APP_NAME=TindahanIQ
APP_ENV=development
LOG_LEVEL=INFO

# Store profile defaults
STORE_NAME=My Sari-Sari Store
CURRENCY_SYMBOL=₱
CURRENCY_CODE=PHP

# Local SQLite persistence path (development/testing)
DATABASE_PATH=data/tindahaniq.db

# Production Turso (libSQL) persistence (used when APP_ENV=production)
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# AI Provider settings (AI Business Consultant)
OPENAI_API_KEY=
OPENAI_BASE_URL=https://aiki-labs.up.railway.app/api/v1
OPENAI_MODEL=gpt-6-luna
OPENAI_MAX_COMPLETION_TOKENS=1024

# Optional Secondary AI Fallback Provider
OPENAI_FALLBACK_BASE_URL=
OPENAI_FALLBACK_MODEL=
OPENAI_FALLBACK_API_KEY=
